[Unit]
Description=Ollama: Lucy's offline brain (local LLM server, localhost only)
Documentation=file:///opt/lucy/src/docs/ARCHITECTURE.md
After=network.target

[Service]
ExecStart=/usr/local/bin/ollama serve
# A throwaway system user that owns nothing but the model store.
DynamicUser=yes
StateDirectory=ollama
Environment=HOME=/var/lib/ollama OLLAMA_MODELS=/var/lib/ollama/models
# Only Lucy, on this Pi, can talk to the model.
Environment=OLLAMA_HOST=127.0.0.1:11434
# Never hand a question to Ollama's cloud: the offline brain must really be offline.
Environment=OLLAMA_NO_CLOUD=1
# Lucy loads the model at start-up; keep it in RAM from then on (idle RAM costs no power).
Environment=OLLAMA_KEEP_ALIVE=-1 OLLAMA_MAX_LOADED_MODELS=1 OLLAMA_NUM_PARALLEL=1
# Children's questions are short; a 2K context keeps the KV cache (RAM) small.
Environment=OLLAMA_CONTEXT_LENGTH=2048
Restart=always
RestartSec=3

# If memory runs short, the kernel should stop the backup brain, never Lucy herself.
MemoryMax=2G
OOMScoreAdjust=300

# Sandbox (DynamicUser already implies a read-only system, private /tmp, no privilege gain).
CapabilityBoundingSet=
PrivateDevices=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
