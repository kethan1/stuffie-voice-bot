[Unit]
Description=Lucy the Goose setup mode: her own Wi-Fi and a settings page for a grown-up's phone
Documentation=file:///opt/lucy/src/docs/OPERATIONS.md
# Setup mode uses her speaker, motors, and wing button, so Lucy rests while it runs.
# Started by lucy-setup.path (her wing held while she wakes up, or two taps on it and "enter
# setup mode" while she is awake), lucy-setup-offline.service (no network after boot), or by
# hand: sudo lucy setup
Conflicts=lucy.service
After=lucy.service NetworkManager.service sound.target
Wants=NetworkManager.service

[Service]
Type=exec
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/lucy/venv/bin/lucy --config /etc/lucy/config.toml setup
# However setup mode ends (finished, timed out, crashed, or stopped): with a read-only root,
# copy the new settings and Wi-Fi networks to the SD card ("+": outside the sandbox below),
# then wake Lucy up again ("+" too: starting a unit needs root's full privileges).
# "-": neither step can keep the other from running.
ExecStopPost=-+/usr/local/sbin/lucy-persist
ExecStopPost=-+/bin/systemctl start --no-block lucy.service
TimeoutStopSec=20
MemoryMax=1G

# Root, because it changes NetworkManager's connections and /etc/lucy, but with no capability
# except serving the page on port 80, and a read-only view of everything else. The page is
# only served on Lucy's own hotspot (10.42.0.1), whose password is on the card inside her.
# /var/lib/lucy holds her logbook, which the page shows and can delete ("-": it is not there
# until Lucy has run once).
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/etc/lucy /etc/NetworkManager/system-connections -/var/lib/lucy
ProtectHome=yes
PrivateTmp=yes
# The motors' PWM channels live in /sys.
ProtectKernelTunables=no
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
DevicePolicy=closed
DeviceAllow=char-alsa rw
DeviceAllow=char-gpiochip rw
UMask=0077
