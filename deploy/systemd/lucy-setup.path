[Unit]
Description=Start Lucy's setup mode when she asks for it
# She asks when her wing is held while she wakes up, or when it is tapped twice and then
# held while a grown-up says "enter setup mode".
Documentation=file:///opt/lucy/src/docs/OPERATIONS.md

[Path]
# Lucy (lucy.service, RuntimeDirectory=lucy) writes this file. It goes away when she stops.
PathExists=/run/lucy/setup-request
Unit=lucy-setup.service

[Install]
WantedBy=multi-user.target
